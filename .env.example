# 로컬 개발용 — 이 파일을 `.env` 로 복사 후 실제 값으로 교체. `.env` 는 절대 커밋하지 마세요.

# DB (docker-compose 가 아래 3개를 사용)
POSTGRES_DB=backendlab
POSTGRES_USER=backendlab_app
# 운영 비밀번호는 최소 24자 이상 무작위 (예: openssl rand -base64 32). 절대 기본값 사용 금지.
POSTGRES_PASSWORD=change-me-strong-random-secret

# 앱이 직접 읽는 변수 (compose 외 환경에서 사용 시)
DB_URL=jdbc:postgresql://localhost:5432/backendlab
DB_USERNAME=backendlab_app
DB_PASSWORD=change-me-strong-random-secret

# CORS 화이트리스트 (와일드카드 금지)
# - local/dev 예시: http://localhost:5173
# - prod 예시: https://devcamel.dev
# - 둘 다 필요할 때만 콤마로 함께 명시
CORS_ALLOWED_ORIGINS=http://localhost:5173

# compose 기본값은 prod 입니다.
# 로컬 개발은 `docker-compose.dev.yml` 이 `SPRING_PROFILES_ACTIVE=dev` 를 주입합니다.
# compose 외 실행 예시가 필요하면 아래 값을 직접 export/set 하세요.
# SPRING_PROFILES_ACTIVE=dev

# 텔레그램 배치 알림 (필요할 때만 활성화)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

