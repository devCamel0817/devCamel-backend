# 운영용 예시 환경 파일
# 실제 배포 시 이 파일을 `.env` 또는 서버 전용 secret 파일로 복사해서 사용하세요.
# 절대 실비밀값을 git 에 커밋하지 마세요.

# compose / postgres
POSTGRES_DB=backendlab
POSTGRES_USER=backendlab_app
POSTGRES_PASSWORD=replace-with-strong-random-secret-at-least-24-chars

# app runtime
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=https://api.example.com,https://devcamel.dev

# compose 외 환경에서 앱을 직접 실행할 때만 사용
DB_URL=jdbc:postgresql://localhost:5432/backendlab
DB_USERNAME=backendlab_app
DB_PASSWORD=replace-with-strong-random-secret-at-least-24-chars

